generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  worker
}

enum UserType {
  staff
  dropshipping_customer
}

enum CustomerOrgRole {
  owner
  manager
  staff
}

enum PosUserRole {
  admin_general
  store_admin
  cashier
}

enum PosPermissionEffect {
  grant
  deny
}

enum InviteCodeStatus {
  active
  disabled
  expired
}

enum DsOrderShippingStatus {
  pending
  shipped
  cancelled
}

enum DsFinanceStatus {
  unpaid
  partial
  paid
}

enum DsOrderAttachmentType {
  label
  proof
}

enum ReceiptStatus {
  pending
  in_progress
  completed
}

enum ItemStatus {
  pending
  in_progress
  completed
}

enum EvidenceType {
  photo
}

model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @default("default")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  companies            Company[]
  users                User[]
  receipts             Receipt[]
  receiptItems         ReceiptItem[]
  evidences            Evidence[]
  scanLogs             ScanLog[]
  idempotencyRecords   IdempotencyRecord[]
  importBatches        ImportBatch[]
  shareTokens          ShareToken[]
  masterReceipts       MasterReceipt[]
  masterReceiptSources MasterReceiptSource[]
  masterShareLinks     MasterShareLink[]

  ygOrderImports       YgOrderImport[]
  ygCustomerImports    YgCustomerImport[]
  ygSupplierOrders     YgSupplierOrder[]
  ygSupplierOrderItems YgSupplierOrderItemS[]
  productCatalogs      ProductCatalog[]
  productImportBatches ProductImportBatch[]
  yogoProductSources   YogoProductSource[]
  yogoProductSyncLogs  YogoProductSyncLog[]
  ygOrderSyncLogs      YgOrderSyncLog[]
  supplierProductSources SupplierProductSource[]
  userPermissions      UserPermission[]
  suppliers            SupplierProfile[]
  customers            CustomerProfile[]
  customerManualOrderRecords CustomerManualOrderRecord[]
  customerPaymentRecords CustomerPaymentRecord[]
  catalogConfigs       CatalogConfig[]
  categoryMaps         ProductCategoryMap[]
  dsCustomers          DropshippingCustomer[]
  dsProducts           DropshippingProduct[]
  dsInventories        DropshippingCustomerInventory[]
  dsOrders             DropshippingOrder[]
  dsPayments           DropshippingPayment[]
  dsExchangeRates      DropshippingExchangeRate[]
  dsOrderAttachments   DropshippingOrderAttachment[]
  inviteCodes          InviteCode[]
  inviteCodeUsages     InviteCodeUsage[]
  permissionGrants     UserPermissionGrant[]
  posPermissionOverrides PosUserPermissionOverride[]
  posAuditLogs           PosAuditLog[]
  posInventoryMovements  PosInventoryMovement[]
  posProductConfigs      PosProductConfig[]
  posQuoteRecords        PosQuoteRecord[]
  posRefundRecords       PosRefundRecord[]
  posSaleRecords         PosSaleRecord[]
  posStoreInventories    PosStoreInventory[]
  posStoreSettings       PosStoreSetting[]
  posSuspendedOrderRecords PosSuspendedOrderRecord[]
  posTicketSettings      PosTicketSetting[]
  posTransferRecords     PosTransferRecord[]
  dsQuickStoreBindings DsQuickStoreBinding[]
  dsQuickSelectedProducts DsQuickSelectedProduct[]
  dsQuickProductDrafts DsQuickProductDraft[]
  billingActionLogs    BillingActionLog[]
}

model Company {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String   @default("default")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  users                User[]
  receipts             Receipt[]
  receiptItems         ReceiptItem[]
  evidences            Evidence[]
  scanLogs             ScanLog[]
  idempotencyRecords   IdempotencyRecord[]
  importBatches        ImportBatch[]
  shareTokens          ShareToken[]
  masterReceipts       MasterReceipt[]
  masterReceiptSources MasterReceiptSource[]
  masterShareLinks     MasterShareLink[]

  ygOrderImports       YgOrderImport[]
  ygCustomerImports    YgCustomerImport[]
  ygSupplierOrders     YgSupplierOrder[]
  ygSupplierOrderItems YgSupplierOrderItemS[]
  productCatalogs      ProductCatalog[]
  productImportBatches ProductImportBatch[]
  yogoProductSources   YogoProductSource[]
  yogoProductSyncLogs  YogoProductSyncLog[]
  ygOrderSyncLogs      YgOrderSyncLog[]
  supplierProductSources SupplierProductSource[]
  userPermissions      UserPermission[]
  suppliers            SupplierProfile[]
  customers            CustomerProfile[]
  customerManualOrderRecords CustomerManualOrderRecord[]
  customerPaymentRecords CustomerPaymentRecord[]
  catalogConfigs       CatalogConfig[]
  categoryMaps         ProductCategoryMap[]
  dsCustomers          DropshippingCustomer[]
  dsProducts           DropshippingProduct[]
  dsInventories        DropshippingCustomerInventory[]
  dsOrders             DropshippingOrder[]
  dsPayments           DropshippingPayment[]
  dsExchangeRates      DropshippingExchangeRate[]
  dsOrderAttachments   DropshippingOrderAttachment[]
  inviteCodes          InviteCode[]
  inviteCodeUsages     InviteCodeUsage[]
  permissionGrants     UserPermissionGrant[]
  posPermissionOverrides PosUserPermissionOverride[]
  posAuditLogs           PosAuditLog[]
  posInventoryMovements  PosInventoryMovement[]
  posProductConfigs      PosProductConfig[]
  posQuoteRecords        PosQuoteRecord[]
  posRefundRecords       PosRefundRecord[]
  posSaleRecords         PosSaleRecord[]
  posStoreInventories    PosStoreInventory[]
  posStoreSettings       PosStoreSetting[]
  posSuspendedOrderRecords PosSuspendedOrderRecord[]
  posTicketSettings      PosTicketSetting[]
  posTransferRecords     PosTransferRecord[]
  dsQuickStoreBindings DsQuickStoreBinding[]
  dsQuickSelectedProducts DsQuickSelectedProduct[]
  dsQuickProductDrafts DsQuickProductDraft[]
  billingActionLogs    BillingActionLog[]

  @@index([tenant_id])
}

model User {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid
  dropshipping_customer_id String? @db.Uuid

  user_id       String
  name          String
  name_zh       String?
  name_en       String?
  phone         String
  phone_country String? @default("MX")
  company_name  String?
  email         String?
  avatar_url    String?
  remark        String?
  data_source   String  @default("platform_created")
  updated_by_user_id String? @db.Uuid
  password_hash String
  role          Role    @default(worker)
  user_type     UserType @default(staff)
  customer_org_role CustomerOrgRole?
  pos_role      PosUserRole @default(store_admin)
  pos_store_id  String?
  active        Boolean @default(true)
  default_landing_path String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant               Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company              Company                @relation(fields: [company_id], references: [id], onDelete: Cascade)
  dropshippingCustomer DropshippingCustomer?  @relation(fields: [dropshipping_customer_id], references: [id], onDelete: SetNull)
  permission           UserPermission?
  inviteCodeUsages     InviteCodeUsage[]
  createdInviteCodes   InviteCode[]           @relation("InviteCodeCreator")
  permissionGrants     UserPermissionGrant[]
  posPermissionOverrides PosUserPermissionOverride[]
  dsQuickStoreBindings DsQuickStoreBinding[]
  dsQuickSelectedProducts DsQuickSelectedProduct[]
  dsQuickProductDrafts DsQuickProductDraft[]

  @@unique([tenant_id, company_id, user_id])
  @@unique([tenant_id, company_id, phone])
  @@index([tenant_id, company_id, name])
  @@index([tenant_id, company_id])
  @@index([dropshipping_customer_id])
}

model UserPermission {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid
  user_id    String @unique @db.Uuid

  manage_suppliers       Boolean @default(true)
  manage_products        Boolean @default(true)
  manage_customers       Boolean @default(true)
  export_product_catalog Boolean @default(true)
  view_reports           Boolean @default(true)
  inspect_goods          Boolean @default(true)
  import_receipts        Boolean @default(true)
  export_all_data        Boolean @default(false)
  view_all_data          Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, company_id, user_id])
  @@index([tenant_id, company_id])
  @@map("user_permissions")
}

model PermissionDefinition {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  module      String
  page        String
  action      String
  label       String
  description String?
  sort_order  Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  templateItems         PermissionTemplateItem[]
  permissionGrants      UserPermissionGrant[]
  posPermissionOverrides PosUserPermissionOverride[]

  @@index([module, page, action])
  @@map("permission_definitions")
}

model PermissionTemplate {
  id            String @id @default(uuid()) @db.Uuid
  template_name String
  template_code String @unique
  description   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  items InviteCode[] @relation("InviteCodePermissionTemplate")
  permissionItems PermissionTemplateItem[]

  @@map("permission_templates")
}

model PermissionTemplateItem {
  id             String @id @default(uuid()) @db.Uuid
  template_id    String @db.Uuid
  permission_key String
  allowed        Boolean @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  template   PermissionTemplate  @relation(fields: [template_id], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@unique([template_id, permission_key])
  @@index([permission_key])
  @@map("permission_template_items")
}

model InviteCode {
  id                       String           @id @default(uuid()) @db.Uuid
  tenant_id                String           @db.Uuid
  company_id               String           @db.Uuid
  code                     String
  status                   InviteCodeStatus @default(active)
  max_uses                 Int              @default(1)
  used_count               Int              @default(0)
  expires_at               DateTime?
  remark                   String?
  created_by               String?          @db.Uuid
  register_user_type       UserType         @default(dropshipping_customer)
  permission_template_code String?
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt

  tenant             Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company            Company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  creator            User?               @relation("InviteCodeCreator", fields: [created_by], references: [id], onDelete: SetNull)
  usages             InviteCodeUsage[]
  permissionTemplate PermissionTemplate? @relation("InviteCodePermissionTemplate", fields: [permission_template_code], references: [template_code], onDelete: SetNull)

  @@unique([tenant_id, company_id, code])
  @@index([tenant_id, company_id])
  @@index([status, expires_at])
  @@map("invite_codes")
}

model InviteCodeUsage {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  company_id      String   @db.Uuid
  invite_code_id  String   @db.Uuid
  user_id         String   @db.Uuid
  used_at         DateTime @default(now())
  register_ip     String?
  register_source String?

  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inviteCode InviteCode @relation(fields: [invite_code_id], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([invite_code_id, user_id])
  @@index([tenant_id, company_id])
  @@index([user_id, used_at])
  @@map("invite_code_usages")
}

model UserPermissionGrant {
  id             String   @id @default(uuid()) @db.Uuid
  tenant_id      String   @db.Uuid
  company_id     String   @db.Uuid
  user_id        String   @db.Uuid
  permission_key String
  allowed        Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company    Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@unique([tenant_id, company_id, user_id, permission_key])
  @@index([tenant_id, company_id, user_id])
  @@map("user_permission_grants")
}

model PosUserPermissionOverride {
  id             String              @id @default(uuid()) @db.Uuid
  tenant_id      String              @db.Uuid
  company_id     String              @db.Uuid
  user_id        String              @db.Uuid
  permission_key String
  effect         PosPermissionEffect
  created_by     String?
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt

  tenant     Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company    Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission PermissionDefinition @relation(fields: [permission_key], references: [key], onDelete: Cascade)

  @@unique([tenant_id, company_id, user_id, permission_key])
  @@index([tenant_id, company_id, user_id])
  @@map("pos_user_permission_overrides")
}

model DsQuickStoreBinding {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  company_id       String   @db.Uuid
  user_id          String   @db.Uuid
  platform         String
  shop_name        String?
  bind_status      String   @default("unbound")
  authorized_at    DateTime?
  expired_at       DateTime?
  account_id       String?
  external_shop_id String?
  metadata_json    Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, company_id, user_id, platform])
  @@index([tenant_id, company_id, user_id])
  @@map("ds_quick_store_bindings")
}

model DsQuickSelectedProduct {
  id                    String   @id @default(uuid()) @db.Uuid
  tenant_id             String   @db.Uuid
  company_id            String   @db.Uuid
  user_id               String   @db.Uuid
  platform              String?
  product_catalog_id    String?  @db.Uuid
  sku                   String
  barcode               String?
  name_zh               String?
  name_es               String?
  product_snapshot_json Json?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, company_id, user_id, sku])
  @@index([tenant_id, company_id, user_id])
  @@map("ds_quick_selected_products")
}

model DsQuickProductDraft {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @db.Uuid
  company_id         String   @db.Uuid
  user_id            String   @db.Uuid
  platform           String
  store_binding_id   String?  @db.Uuid
  product_catalog_id String?  @db.Uuid
  sku                String
  product_name       String
  draft_status       String   @default("pending")
  failure_reason     String?
  payload_json       Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, company_id, user_id])
  @@index([platform, draft_status])
  @@map("ds_quick_product_drafts")
}

model SupplierProfile {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  short_name          String
  full_name           String
  logo_url            String?
  contact_name        String?
  phone               String?
  address             String?
  category_discounts  String?
  cooperate_start_at  DateTime?
  account_period_days Int?
  enabled             Boolean   @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, company_id])
  @@index([short_name])
  @@map("supplier_profiles")
}

model SupplierProductSource {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  supplier_profile_id String @db.Uuid
  supplier_name       String
  sku                 String
  barcode             String?
  name_zh             String?
  name_es             String?
  case_pack           Int?
  carton_pack         Int?
  unit_price          Decimal? @db.Decimal(14, 2)
  last_import_batch   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, company_id, supplier_profile_id, sku])
  @@index([tenant_id, company_id, supplier_profile_id])
  @@index([tenant_id, company_id, supplier_name])
  @@index([sku])
  @@map("supplier_product_sources")
}

model CustomerProfile {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  name            String
  contact_name    String?
  mobile          String?
  whatsapp        String?
  email           String?
  store_addresses String?
  city_country    String?
  customer_type   String?
  vip_level       String?
  credit_level    String?
  payment_term_days Int?
  tag_text        String?
  order_stat_text String?
  manual_order_count  Int?
  manual_order_amount Decimal? @db.Decimal(18, 2)
  manual_packing_amount Decimal? @db.Decimal(18, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  manual_order_records CustomerManualOrderRecord[]
  payment_records CustomerPaymentRecord[]

  @@index([tenant_id, company_id])
  @@index([name])
  @@map("customer_profiles")
}

model CustomerManualOrderRecord {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  customer_profile_id String? @db.Uuid
  customer_name       String
  yg_order_no         String?
  external_order_no   String?
  order_channel       String?
  billing_amount_override Decimal? @db.Decimal(18, 2)
  packing_amount      Decimal? @db.Decimal(18, 2)
  shipped_at          DateTime?
  paid_at             DateTime?
  payment_term_days   Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customerProfile CustomerProfile? @relation(fields: [customer_profile_id], references: [id], onDelete: SetNull)
  payment_records CustomerPaymentRecord[]

  @@index([tenant_id, company_id])
  @@index([customer_profile_id])
  @@index([customer_name])
  @@map("customer_manual_order_records")
}

model CustomerPaymentRecord {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  customer_profile_id    String? @db.Uuid
  manual_order_record_id String? @db.Uuid
  source_type            String
  customer_name          String
  order_no               String
  payment_amount         Decimal? @db.Decimal(18, 2)
  paid_at                DateTime?
  payment_method         String?
  payment_target         String?
  note                   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant            Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company           Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  customerProfile   CustomerProfile?         @relation(fields: [customer_profile_id], references: [id], onDelete: SetNull)
  manualOrderRecord CustomerManualOrderRecord? @relation(fields: [manual_order_record_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, company_id])
  @@index([customer_profile_id])
  @@index([manual_order_record_id])
  @@index([source_type, order_no])
  @@map("customer_payment_records")
}

model CatalogConfig {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  customer          String?
  category          String?
  discount          String?
  show_stock        Boolean @default(true)
  show_image        Boolean @default(true)
  language          String  @default("zh")
  cover_url         String?
  note              String?
  doc_header        String?
  doc_footer        String?
  doc_phone         String?
  doc_logo_url      String?
  doc_logo_position String  @default("right")
  doc_header_align  String  @default("left")
  doc_footer_align  String  @default("right")
  doc_whatsapp      String?
  doc_wechat        String?
  doc_show_whatsapp Boolean @default(false)
  doc_show_wechat   Boolean @default(false)
  doc_show_contact  Boolean @default(true)
  doc_show_header   Boolean @default(true)
  doc_show_footer   Boolean @default(true)
  doc_show_logo     Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, company_id])
  @@index([tenant_id, company_id])
  @@map("catalog_configs")
}

model ProductCategoryMap {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  category_zh String
  category_es String?
  yogo_code   String?
  active      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, company_id, category_zh])
  @@unique([tenant_id, company_id, yogo_code])
  @@index([tenant_id, company_id])
  @@map("product_category_maps")
}

model DropshippingCustomer {
  id         String @id @default(uuid()) @db.Uuid
  tenant_id  String @db.Uuid
  company_id String @db.Uuid

  name                String
  name_zh             String?
  name_en             String?
  contact_name        String?
  phone               String?
  notes               String?
  default_platform    String?
  default_rate_mode   String?
  default_settle_rule String?
  custom_domain         String?
  custom_domain_enabled Boolean @default(false)
  default_access_url    String?
  default_slug          String?
  domain_source         String  @default("system_default")
  domain_status         String  @default("not_set")
  domain_updated_at     DateTime?
  domain_updated_by     String? @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  users       User[]
  inventories DropshippingCustomerInventory[]
  orders      DropshippingOrder[]
  payments    DropshippingPayment[]

  @@unique([tenant_id, company_id, name])
